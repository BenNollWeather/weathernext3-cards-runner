# WeatherNext 3 storm impact card runner settings
# Safe to commit: this file contains only non-secret defaults.
# Existing environment variables take precedence, which allows GitHub Actions
# or launchd to override paths and S3 settings without editing this file.

# Notebook that defines the cards (the copy in notebook/ by default). A
# workstation can point NOTEBOOK_PATH at its working copy in
# config/settings.local.env (not committed), which is read before this file.
NOTEBOOK_PATH="${NOTEBOOK_PATH:-${PROJECT_DIR:-.}/notebook/weathernext3_cyclones.ipynb}"

# Disposable working folder (wiped every run).
WORK_DIR="${WORK_DIR:-/tmp/weathernext3_cards}"

# Cards to render and upload.
CARD_MODES="${CARD_MODES:-light}"
CARD_LAYOUTS="${CARD_LAYOUTS:-3x2}"

# Leave blank for the newest WNV3 run. Format: YYYY_MM_DDTHH_MM.
RUN_OVERRIDE="${RUN_OVERRIDE:-}"

# Skip a run that is already published. The run in the public latest.json is
# the shared record, so this Mac and GitHub Actions never redo each other's work.
SKIP_IF_DONE="${SKIP_IF_DONE:-true}"
PUBLIC_LATEST_URL="${PUBLIC_LATEST_URL:-https://bennollweather.s3.amazonaws.com/climate_imagery/weathernext3/latest.json}"

UPLOAD_TO_S3="${UPLOAD_TO_S3:-true}"
# Cards always go to the same folder. Each run uploads the new cards (same
# storm = same file name, overwritten), then deletes leftover cards from the
# previous run, so the folder holds only the current set.
S3_DEST="${S3_DEST:-s3://bennollweather/climate_imagery/weathernext3/cards/}"
# Index of the current cards (outside the cards folder, never deleted).
S3_LATEST="${S3_LATEST:-s3://bennollweather/climate_imagery/weathernext3/latest.json}"
STATUS_S3_PREFIX="${STATUS_S3_PREFIX:-s3://bennollweather/climate_imagery/status}"
PUBLIC_URL_BASE="${PUBLIC_URL_BASE:-https://bennollweather.s3.amazonaws.com/climate_imagery/weathernext3/cards/}"
PRODUCT_ID="${PRODUCT_ID:-weathernext3-cards}"
PRODUCT_SCHEDULE="${PRODUCT_SCHEDULE:-hourly check for new WNV3 runs}"

# Python with the packages in requirements.txt.
PYTHON_CMD="${PYTHON_CMD:-python3}"

DELETE_WORK_DIR_AFTER_UPLOAD="${DELETE_WORK_DIR_AFTER_UPLOAD:-true}"

# AWS profile for local uploads (empty = default credential chain, e.g. the
# OIDC role on GitHub Actions). Set it in config/settings.local.env.
AWS_PROFILE="${AWS_PROFILE-}"

# Optional CA bundle for networks that re-sign HTTPS traffic (macOS: build it
# with bin/refresh-ca-bundle). Ignored when the file does not exist.
AWS_CA_BUNDLE="${AWS_CA_BUNDLE:-${PROJECT_DIR:-.}/config/ca-bundle.pem}"

# Stop a run that takes longer than this (normal: about 5 minutes).
RUN_TIMEOUT_SECONDS="${RUN_TIMEOUT_SECONDS:-2700}"
